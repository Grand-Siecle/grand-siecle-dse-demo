<?xml version="1.0" encoding="UTF-8"?>
<!--
    Grand Siecle: full-text search page (J3). Rewritten from the template's search.xsl:
    same libraries (instantsearch.js + typesense-instantsearch-adapter from html/vendor),
    French labels, one hit = one printed page. The server and the search-only key come from
    js/search-config.js, generated by pyscripts/make_ts_index.py; the widgets are in js/gs-search.js.
-->
<xsl:stylesheet
    xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
    xmlns:tei="http://www.tei-c.org/ns/1.0"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    version="2.0"
    exclude-result-prefixes="#all">

    <xsl:import href="./partials/html_navbar.xsl"/>
    <xsl:import href="./partials/html_head.xsl"/>
    <xsl:import href="./partials/html_footer.xsl"/>
    <xsl:output encoding="UTF-8" media-type="text/html" method="html" version="5.0" indent="yes" omit-xml-declaration="yes"/>

    <xsl:template name="facet">
        <xsl:param name="id"/>
        <xsl:param name="label"/>
        <section class="gs-facet" aria-labelledby="{$id}-title">
            <h2 class="gs-facet-title" id="{$id}-title"><xsl:value-of select="$label"/></h2>
            <div id="{$id}"/>
        </section>
    </xsl:template>

    <xsl:template match="/">
        <xsl:variable name="doc_title" select="'Recherche'"/>
        <html lang="{$default_lang}">
            <head>
                <xsl:call-template name="html_head">
                    <xsl:with-param name="html_title" select="concat($doc_title, ' — ', $project_short_title)"/>
                    <xsl:with-param name="bootstrap_icons" select="false()"/>
                </xsl:call-template>
            </head>
            <body class="d-flex flex-column min-vh-100 gs-search-page">
                <xsl:call-template name="nav_bar"/>
                <main id="main" tabindex="-1" class="container gs-main flex-grow-1">
                    <div class="gs-search">
                        <!-- heading block as on the MaX search page -->
                        <p class="gs-section-kicker">Recherche</p>
                        <h1 class="gs-section-title">Rechercher dans l’édition</h1>
                        <p class="gs-section-intro">Recherche plein texte (Typesense) dans le texte modernisé, le texte
                            original et les lemmes des 888 pages. Les accents et les petites fautes de frappe sont
                            tolérés ; chaque résultat mène à la page de lecture.</p>
                        <div id="search-error" class="alert alert-warning" role="alert" hidden="hidden"/>
                        <div class="gs-searchbar">
                            <label for="gs-search-input" class="visually-hidden">Rechercher dans les textes</label>
                            <div id="searchbox"/>
                        </div>
                        <div class="gs-search-status">
                            <div id="stats" aria-live="polite"/>
                            <div id="current-refinements"/>
                            <div id="clear-refinements"/>
                        </div>
                        <div class="row">
                            <div class="col-lg-3">
                                <details class="gs-filters" id="gs-filters" open="open">
                                    <summary>Filtres</summary>
                                    <xsl:call-template name="facet"><xsl:with-param name="id" select="'rf-doc'"/><xsl:with-param name="label" select="'Document'"/></xsl:call-template>
                                    <xsl:call-template name="facet"><xsl:with-param name="id" select="'rf-date'"/><xsl:with-param name="label" select="'Date d''édition'"/></xsl:call-template>
                                    <xsl:call-template name="facet"><xsl:with-param name="id" select="'rf-lang'"/><xsl:with-param name="label" select="'Langue'"/></xsl:call-template>
                                    <xsl:call-template name="facet"><xsl:with-param name="id" select="'rf-note'"/><xsl:with-param name="label" select="'Notes marginales'"/></xsl:call-template>
                                    <xsl:call-template name="facet"><xsl:with-param name="id" select="'rf-persons'"/><xsl:with-param name="label" select="'Personnes'"/></xsl:call-template>
                                    <xsl:call-template name="facet"><xsl:with-param name="id" select="'rf-places'"/><xsl:with-param name="label" select="'Lieux'"/></xsl:call-template>
                                    <xsl:call-template name="facet"><xsl:with-param name="id" select="'rf-orgs'"/><xsl:with-param name="label" select="'Organisations'"/></xsl:call-template>
                                    <xsl:call-template name="facet"><xsl:with-param name="id" select="'rf-works'"/><xsl:with-param name="label" select="'Œuvres'"/></xsl:call-template>
                                </details>
                            </div>
                            <div class="col-lg-9">
                                <h2 class="visually-hidden">Résultats</h2>
                                <div id="hits"/>
                                <nav id="pagination" aria-label="Pages de résultats"/>
                            </div>
                        </div>
                    </div>
                </main>
                <xsl:call-template name="html_footer">
                    <xsl:with-param name="bootstrap_js" select="false()"/>
                </xsl:call-template>
                <script src="vendor/instantsearch/instantsearch.production.min.js"/>
                <script src="vendor/typesense-instantsearch-adapter/typesense-instantsearch-adapter.min.js"/>
                <!-- gs-search.js loads js/search-config.js (generated with the search-only key,
                     absent until the index is built) and reports it if missing -->
                <script src="js/gs-search.js"/>
            </body>
        </html>
    </xsl:template>
</xsl:stylesheet>
