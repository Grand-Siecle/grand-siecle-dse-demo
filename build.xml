<?xml version="1.0" encoding="UTF-8"?>
<project basedir="." name="tei2html">
    <!-- Grand Siecle: data/editions and data/indices are produced by pyscripts/import_data.py.
         Removed from the template: search.html (Typesense server hosted by ACDH) and
         noske-search.html (NoSketchEngine hosted by ACDH). data/imprint.xml is a local file
         instead of the ACDH imprint service (shellscripts/dl_imprint.sh).
         No half-empty site on failure: instead of deleting html/*.html before the build,
         every transformation is forced and the files not rewritten by this run are removed
         at the end (only reached if all steps succeeded).
         The template's textual <replace> of xmlns declarations is gone: the partials no longer
         declare the XHTML namespace and shared.xsl excludes the tei prefix. -->
    <property name="index" value="./data/meta/about.xml"/>
    <property name="target" value="./html"/>
    <property name="target_xml" value="./html/xml-view"/>
    <fail message="data/editions contains no TEI: run `uv run pyscripts/import_data.py` first.">
        <condition>
            <resourcecount when="equal" count="0">
                <fileset dir="./data/editions" includes="*.xml"/>
            </resourcecount>
        </condition>
    </fail>
    <tstamp>
        <format property="build.start" pattern="MM/dd/yyyy hh:mm:ss aa" locale="en,US"/>
    </tstamp>
    <xslt force="true" in="${index}" out="${target}/index.html" style="./xslt/index.xsl">
        <factory name="net.sf.saxon.TransformerFactoryImpl"/>
        <classpath location="${basedir}/saxon/saxon9he.jar"/>
    </xslt>
    <xslt force="true" in="${index}" out="${target}/404.html" style="./xslt/404.xsl">
        <factory name="net.sf.saxon.TransformerFactoryImpl"/>
        <classpath location="${basedir}/saxon/saxon9he.jar"/>
    </xslt>
    <xslt force="true" style="./xslt/editions.xsl"  basedir="./data/editions" destdir="${target}" includes="*.xml">
        <factory name="net.sf.saxon.TransformerFactoryImpl"/>
        <classpath location="${basedir}/saxon/saxon9he.jar"/>
    </xslt>
    <xslt force="true" style="./xslt/listentity.xsl" basedir="./data/indices" destdir="${target}"
        includes="listevent.xml,listartwork.xml,listmaterial.xml,listtechnique.xml,listdate.xml">
        <factory name="net.sf.saxon.TransformerFactoryImpl"/>
        <classpath location="${basedir}/saxon/saxon9he.jar"/>
    </xslt>
    <xslt force="true" style="./xslt/meta.xsl"  basedir="./data/meta" destdir="${target}" includes="*.xml">
        <factory name="net.sf.saxon.TransformerFactoryImpl"/>
        <classpath location="${basedir}/saxon/saxon9he.jar"/>
    </xslt>
    <xslt force="true" in="${index}" out="${target}/toc.html" style="./xslt/toc.xsl">
        <factory name="net.sf.saxon.TransformerFactoryImpl"/>
        <classpath location="${basedir}/saxon/saxon9he.jar"/>
    </xslt>
    <xslt force="true" in="./data/imprint.xml" out="${target}/imprint.html" style="./xslt/imprint.xsl">
        <factory name="net.sf.saxon.TransformerFactoryImpl"/>
        <classpath location="${basedir}/saxon/saxon9he.jar"/>
    </xslt>
    <xslt force="true" in="./data/indices/listperson.xml" out="${target}/listperson.html" style="./xslt/listperson.xsl">
        <factory name="net.sf.saxon.TransformerFactoryImpl"/>
        <classpath location="${basedir}/saxon/saxon9he.jar"/>
    </xslt>
    <xslt force="true" in="./data/indices/listplace.xml" out="${target}/listplace.html" style="./xslt/listplace.xsl">
        <factory name="net.sf.saxon.TransformerFactoryImpl"/>
        <classpath location="${basedir}/saxon/saxon9he.jar"/>
    </xslt>
    <xslt force="true" in="./data/indices/listorg.xml" out="${target}/listorg.html" style="./xslt/listorg.xsl">
        <factory name="net.sf.saxon.TransformerFactoryImpl"/>
        <classpath location="${basedir}/saxon/saxon9he.jar"/>
    </xslt>
    <xslt force="true" in="./data/indices/listbibl.xml" out="${target}/listbibl.html" style="./xslt/listbibl.xsl">
        <factory name="net.sf.saxon.TransformerFactoryImpl"/>
        <classpath location="${basedir}/saxon/saxon9he.jar"/>
    </xslt>
    <xslt force="true" in="./data/indices/listperson.xml" out="${target}/beacon.txt" style="./xslt/beacon.xsl">
        <factory name="net.sf.saxon.TransformerFactoryImpl"/>
        <classpath location="${basedir}/saxon/saxon9he.jar"/>
    </xslt>
    <xslt force="true" in="./data/imprint.xml" out="${target}/api.xml" style="./xslt/api.xsl">
        <factory name="net.sf.saxon.TransformerFactoryImpl"/>
        <classpath location="${basedir}/saxon/saxon9he.jar"/>
    </xslt>
    <copy todir="${target}" flatten="true" overwrite="true">
        <fileset dir="./data/">
            <include name="**/*.xml"/>
        </fileset>
    </copy>
    <!-- remove pages and XML copies left over from previous builds -->
    <delete>
        <fileset dir="${target}" includes="*.html,*.xml">
            <date datetime="${build.start}" pattern="MM/dd/yyyy hh:mm:ss aa" when="before"/>
        </fileset>
    </delete>
</project>
